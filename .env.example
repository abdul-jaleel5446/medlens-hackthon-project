# MedLens — environment variables for the n8n instance
# Start n8n with these set, e.g.:
#   $env:OPENAI_API_KEY="sk-..."; $env:LANGCHAIN_API_URL="http://localhost:8000"; $env:REVIEW_WEBHOOK_URL="https://webhook.site/xxx"; npx n8n

# OpenAI key used by the classification + summarization LLM calls (gpt-4o-mini)
OPENAI_API_KEY=sk-your-openai-key

# Base URL of your partner's LangChain Q&A service (n8n POSTs to {LANGCHAIN_API_URL}/ask)
LANGCHAIN_API_URL=http://localhost:8000

# Where high-risk summaries are sent for human review (Slack webhook, webhook.site, or a review n8n workflow)
REVIEW_WEBHOOK_URL=https://webhook.site/your-unique-id
